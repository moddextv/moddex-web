# copy to .env and fill in. never commit .env.
#
#   cp .env.example .env && docker compose up
#
# the DB_* defaults below match compose.yaml, so a local stack works as-is;
# only the twitch and stripe credentials need real values.

# ----------------------------------------------------------- local ports ---
# host-side ports only (compose.yaml). change these if something already
# listens on 4999/3306 outside docker.
APP_PORT=4999
DB_PORT_HOST=3306

# --------------------------------------------------------------- runtime ---
# public origin of the app. must match the twitch oauth redirect url.
NEXTAUTH_URL=http://localhost:4999
# required when running behind a reverse proxy
AUTH_TRUST_HOST=true
# openssl rand -base64 32
AUTH_SECRET=

# -------------------------------------------------------------- database ---
# DB_HOST/DB_PORT are overridden by compose to point at the db service
DB_HOST=db
DB_PORT=3306
DB_NAME=moddex
DB_USER=moddex
DB_PASS=moddex
DB_CONNECTION_LIMIT=10
# used by the mariadb container and the backup job (production)
DB_ROOT_PASS=root

# ---------------------------------------------------------------- twitch ---
# https://dev.twitch.tv/console/apps — oauth app for user login
AUTH_TWITCH_ID=
AUTH_TWITCH_SECRET=
# the *web* client-id used for the private gql endpoint that serves mod/vip
# lists. this is not the oauth app id above.
AUTH_TWITCH_CLIENT_ID=

# ---------------------------------------------------------------- stripe ---
STRIPE_SECRET_KEY=
STRIPE_DONATION_PRICE=
# NOTE: inlined into the client bundle at build time, so it must also be passed
# as a --build-arg when building the production image.
NEXT_PUBLIC_PUBLISHABLE_SECRET_KEY=

# ------------------------------------------------------ production deploy ---
# only used by compose.prod.yaml
IMAGE=ghcr.io/OWNER/REPO
IMAGE_TAG=latest
BACKUP_RETENTION_DAYS=14
