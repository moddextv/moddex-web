# copy to .env and fill in. never commit .env.
#
#   cp .env.example .env && docker compose up
#
# the DB_* defaults below match compose.yaml, so a local stack works as-is;
# only the twitch and stripe credentials need real values.

# ----------------------------------------------------------- local ports ---
# host-side ports only (compose.yaml). change these if something already
# listens on 4999/3306 outside docker.
APP_PORT=4999

# --------------------------------------------------------------- runtime ---
# public origin of the app. must match the twitch oauth redirect url.
NEXTAUTH_URL=http://localhost:4999
# required when running behind a reverse proxy
AUTH_TRUST_HOST=true
# openssl rand -base64 32
AUTH_SECRET=

# --------------------------------------------------------------- database ---
# none. moddex-api owns the database; this app asks it over http.
# see MODDEX_API_URL / INTERNAL_API_TOKEN below.


# ---------------------------------------------------------------- twitch ---
# https://dev.twitch.tv/console/apps — oauth app for user login
AUTH_TWITCH_ID=
AUTH_TWITCH_SECRET=
# the *web* client-id used for the private gql endpoint that serves mod/vip
# lists. this is not the oauth app id above.
AUTH_TWITCH_CLIENT_ID=

# ---------------------------------------------------------------- stripe ---
STRIPE_SECRET_KEY=
STRIPE_DONATION_PRICE=
# NOTE: inlined into the client bundle at build time, so it must also be passed
# as a --build-arg when building the production image.
NEXT_PUBLIC_PUBLISHABLE_SECRET_KEY=

# ------------------------------------------------------ production deploy ---
# only used by compose.prod.yaml
IMAGE=ghcr.io/OWNER/REPO
IMAGE_TAG=latest
BACKUP_RETENTION_DAYS=14

# ------------------------------------------------------- moddex-api (v2) ---
# phase 2: this app no longer holds a database connection. everything it needs
# comes from moddex-api, which owns the database.
MODDEX_API_URL=https://api.moddex.tv

# must match INTERNAL_API_TOKEN on moddex-api. SERVER-SIDE ONLY -- whoever
# holds it can read any user's donation total and write as any user. it is read
# in src/utils/api/moddex.ts, which is marked `server-only` so a client import
# fails the build. never add it to src/config.ts (that module is bundled for
# the browser) and never name it NEXT_PUBLIC_ anything.
INTERNAL_API_TOKEN=
